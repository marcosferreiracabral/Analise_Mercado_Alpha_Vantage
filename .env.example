# ==============================================================================
# Alpha Vantage Market Data Pipeline - Environment Configuration Template
# ==============================================================================

# Alpha Vantage API Key (Obtenha gratuitamente em https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_API_KEY

# Taxa de chamadas da API (segundos de pausa entre requisições para respeitar o limite)
# Plano gratuito: 5 chamadas/min e 25 chamadas/dia -> recomendação: 12.0s
ALPHA_VANTAGE_RATE_LIMIT_PAUSE=12.0

# Limite diário máximo de requisições de segurança para evitar ultrapassar o plano gratuito
ALPHA_VANTAGE_DAILY_MAX_REQUESTS=25

# Modo de Armazenamento: 'auto', 'bigquery', ou 'local'
# - auto: Tenta BigQuery se configurado, caso contrário faz fallback gracioso para local (SQLite/Parquet)
# - bigquery: Exige BigQuery e credenciais GCP
# - local: Utiliza SQLite + Parquet no diretório ./data
STORAGE_MODE=auto

# Diretório base para persistência local
LOCAL_DATA_DIR=./data

# Google Cloud Platform / BigQuery Configuration
# Deixe vazio se for utilizar apenas o modo local
GCP_PROJECT_ID=
BIGQUERY_DATASET=market_data
BIGQUERY_LOCATION=US

# Caminho relativo ou absoluto para o arquivo JSON da Service Account do GCP
# Exemplo: ./credentials/service_account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Timezone padrão do pipeline para normalização
DEFAULT_TIMEZONE=America/Sao_Paulo

# Nível de Log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
